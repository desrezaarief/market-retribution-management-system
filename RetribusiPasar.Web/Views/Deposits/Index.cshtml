@model IEnumerable<Deposit>
@{ViewData["Title"]="Setoran";var markets=ViewBag.MarketNames as Dictionary<int,string>??new Dictionary<int,string>();}
<div class="panel"><div class="toolbar"><h2>Riwayat Setoran</h2><a class="btn js-modal-link" asp-action="Create">+ Buat Setoran</a></div><table><thead><tr><th>No Setoran</th><th>Tanggal</th><th>Pasar</th><th class="num">Transaksi</th><th class="num">Jumlah</th><th>Status</th><th></th></tr></thead><tbody>
@foreach(var x in Model){<tr><td>@x.DepositNo</td><td>@x.DepositDate.ToString("dd/MM/yyyy")</td><td>@markets.GetValueOrDefault(x.MarketId,"-")</td><td class="num">@x.ReceiptIds.Count</td><td class="num">@FormatHelper.Rupiah(x.Amount)</td><td><span class="tag ok">@x.Status</span></td><td><div class="actions"><a class="icon-action edit js-modal-link" asp-action="Edit" asp-route-id="@x.Id" title="Ubah" aria-label="Ubah"><svg class="crud-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></a><a class="icon-action delete js-modal-link" asp-action="Delete" asp-route-id="@x.Id" title="Hapus" aria-label="Hapus"><svg class="crud-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v5M14 11v5"/></svg></a></div></td></tr>}</tbody></table></div>
