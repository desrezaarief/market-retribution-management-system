@model IEnumerable<MediaDistribution>
@{ViewData["Title"]="Distribusi Media";var markets=ViewBag.MarketNames as Dictionary<int,string>??new Dictionary<int,string>();}
<div class="panel"><div class="toolbar"><h2>Riwayat Serah Terima</h2><a class="btn js-modal-link" asp-action="Create">+ Distribusi Media</a></div><table><thead><tr><th>No BA</th><th>Tanggal</th><th>Pasar</th><th>Media</th><th>Range</th><th class="num">Lembar</th><th></th></tr></thead><tbody>
@foreach(var x in Model){<tr><td>@x.DistributionNo</td><td>@x.DistributionDate.ToString("dd/MM/yyyy")</td><td>@markets.GetValueOrDefault(x.MarketId,"-")</td><td>@x.MediaType</td><td class="serial">@x.StartSerial.ToString("000000")-@x.EndSerial.ToString("000000")</td><td class="num">@FormatHelper.Number(x.TotalSheets)</td><td><div class="actions"><a class="icon-action edit js-modal-link" asp-action="Edit" asp-route-id="@x.Id" title="Ubah" aria-label="Ubah"><svg class="crud-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></a><a class="icon-action delete js-modal-link" asp-action="Delete" asp-route-id="@x.Id" title="Hapus" aria-label="Hapus"><svg class="crud-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v5M14 11v5"/></svg></a></div></td></tr>}
</tbody></table></div>
