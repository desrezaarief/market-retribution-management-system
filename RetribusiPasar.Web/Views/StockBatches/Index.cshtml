@model IEnumerable<StockBatch>
@{ViewData["Title"]="Penerimaan Stok Media";}
<div class="panel"><div class="toolbar"><h2>Kartu Stok / Batch</h2><a class="btn js-modal-link" asp-action="Create">+ Terima Stok</a></div><table><thead><tr><th>Media</th><th>Tanggal</th><th>Range Seri</th><th class="num">Lembar</th><th>Dokumen</th><th>Status</th><th></th></tr></thead><tbody>
@foreach(var x in Model){<tr><td>@x.MediaType</td><td>@x.ReceivedDate.ToString("dd/MM/yyyy")</td><td class="serial">@x.StartSerial.ToString("000000")-@x.EndSerial.ToString("000000")</td><td class="num">@FormatHelper.Number(x.TotalSheets)</td><td>@x.DocumentNo</td><td><span class="tag @(x.IsActive?"ok":"bad")">@(x.IsActive?"Aktif":"Nonaktif")</span></td><td><div class="actions"><a class="icon-action edit js-modal-link" asp-action="Edit" asp-route-id="@x.Id" title="Ubah" aria-label="Ubah"><svg class="crud-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></a><a class="icon-action delete js-modal-link" asp-action="Delete" asp-route-id="@x.Id" title="Hapus" aria-label="Hapus"><svg class="crud-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v5M14 11v5"/></svg></a></div></td></tr>}
</tbody></table></div>
