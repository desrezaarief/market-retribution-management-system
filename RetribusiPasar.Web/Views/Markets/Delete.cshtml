@model Market
@{ViewData["Title"]="Hapus Pasar";}
<div class="panel"><h2>Hapus @Model.Name?</h2><p>Kode: <b>@Model.Code</b>. Pastikan data ini belum direferensikan transaksi.</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden"/><button class="btn danger">Hapus</button> <a class="btn secondary js-modal-close" asp-action="Index">Batal</a></form></div>
