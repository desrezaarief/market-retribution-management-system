@model Receipt
@{
    var marketItems = ViewBag.Markets as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var typeItems = ViewBag.Types as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var collectorItems = ViewBag.Collectors as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}
<div asp-validation-summary="ModelOnly"></div>
<div id="ReceiptFormConfig" data-context-url='@Url.Action("FormContext", "Receipts")'></div>

<input asp-for="Id" type="hidden" id="ReceiptId" />
<input asp-for="Status" type="hidden" />

<!-- Nilai sebenarnya yang dikirim ke backend -->
<input asp-for="MarketId" type="hidden" id="MarketId" />
<input asp-for="RetributionTypeId" type="hidden" id="RetributionTypeId" />
<input asp-for="CollectorId" type="hidden" id="CollectorId" />

<div class="grid">
    <div>
        <label asp-for="TransactionNo"></label>
        <input asp-for="TransactionNo" readonly />
    </div>

    <div>
        <label asp-for="ReceiptDate"></label>
        <input asp-for="ReceiptDate" type="date" />
    </div>

    <div class="full">
        <label asp-for="UnitId">Kios / Los / Unit</label>
        <select asp-for="UnitId" asp-items="ViewBag.Units" id="UnitId">
            <option value="">-- tanpa unit / transaksi langsung --</option>
        </select>
        <small class="muted">
            Jika unit dipilih, Pasar, Jenis Retribusi, Media, Petugas, dan Tarif akan mengikuti master unit secara otomatis.
        </small>
    </div>

    <div>
        <label>Pasar</label>
        <select id="MarketSelect">
            <option value="">-- pilih --</option>
            @foreach (var item in marketItems)
            {
                <option value="@item.Value">@item.Text</option>
            }
        </select>
        <small class="muted" id="MarketLockInfo"></small>
    </div>

    <div>
        <label>Jenis Retribusi</label>
        <select id="RetributionTypeSelect">
            <option value="">-- pilih --</option>
            @foreach (var item in typeItems)
            {
                <option value="@item.Value">@item.Text</option>
            }
        </select>
        <small class="muted" id="TypeLockInfo"></small>
    </div>

    <div>
        <label>Media</label>
        <input id="MediaTypeDisplay" readonly value="-" />
        <small class="muted">Otomatis mengikuti Jenis Retribusi.</small>
    </div>

    <div>
        <label>Petugas</label>
        <select id="CollectorSelect">
            <option value="">-- tanpa petugas --</option>
            @foreach (var item in collectorItems)
            {
                <option value="@item.Value">@item.Text</option>
            }
        </select>
        <small class="muted" id="CollectorLockInfo"></small>
    </div>

    <div>
        <label asp-for="PeriodStart"></label>
        <input asp-for="PeriodStart" type="date" id="PeriodStart" />
    </div>

    <div>
        <label asp-for="Months"></label>
        <input asp-for="Months" type="text" inputmode="numeric" data-digits-only maxlength="2" id="Months" />
    </div>

    <div>
        <label>Tarif Aktif</label>
        <input id="TariffDisplay" readonly value="Rp0" />
    </div>

    <div>
        <label asp-for="ExpectedAmount"></label>
        <input asp-for="ExpectedAmount" type="text" inputmode="numeric" data-number-format id="ExpectedAmount" value="@Model.ExpectedAmount.ToString("0")" readonly />
        <small class="muted">Dihitung ulang oleh backend saat disimpan.</small>
    </div>

    <div class="full" id="SerialSection">
        <div class="grid">
            <div>
                <label asp-for="StartSerial"></label>
                <input asp-for="StartSerial" id="StartSerial" maxlength="6" inputmode="numeric" data-digits-only />
            </div>
            <div>
                <label asp-for="EndSerial"></label>
                <input asp-for="EndSerial" id="EndSerial" maxlength="6" inputmode="numeric" data-digits-only />
            </div>
        </div>

        <div class="serial-availability" style="margin-top:8px">
            <b>Range media yang masih tersedia pada pasar ini:</b>
            <div id="AvailableSerialRanges" class="muted">Pilih Pasar/Jenis terlebih dahulu.</div>
        </div>
    </div>

    <div>
        <label asp-for="ReceivedAmount"></label>
        <input asp-for="ReceivedAmount" type="text" inputmode="numeric" data-number-format id="ReceivedAmount" value="@Model.ReceivedAmount.ToString("0")" />
    </div>

    <div>
        <label asp-for="PaymentMethod"></label>
        <select asp-for="PaymentMethod">
            <option>Tunai</option>
            <option>Transfer</option>
            <option>QRIS</option>
        </select>
    </div>

    <div>
        <label asp-for="PaymentReference"></label>
        <input asp-for="PaymentReference" />
    </div>

    <div class="full">
        <label asp-for="Notes"></label>
        <textarea asp-for="Notes" rows="3"></textarea>
    </div>
</div>
