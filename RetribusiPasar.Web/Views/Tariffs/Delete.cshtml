@model Tariff
@{ViewData["Title"]="Hapus Tarif";}
<div class="panel"><h2>Hapus tarif @FormatHelper.Rupiah(Model.Amount)?</h2><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden"/><button class="btn danger">Hapus</button> <a class="btn secondary js-modal-close" asp-action="Index">Batal</a></form></div>
